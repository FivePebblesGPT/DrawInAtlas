cache safety\n        id: ci_t065_real_source_io\n        if: ${{ !cancelled() }}\n        continue-on-error: true\n        shell: bash\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://drawing/tests/asset_browser_real_io_smoke.gd 2>&1 | tee /tmp/godot-t065-real-io.log\n          grep -q \'T065_REAL_IO_PASSED\' /tmp/godot-t065-real-io.log\n          if grep -E \'SCRIPT ERROR:|^ERROR:|T065_REAL_IO_FAILED:\' /tmp/godot-t065-real-io.log; then exit 1; fi\n      - name: Verify T-065 explicit portable Object source transfers\n        id: ci_t065_asset_transfer_model\n        if: ${{ !cancelled() }}\n        continue-on-error: true\n        shell: bash\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://drawing/tests/asset_browser_transfer_smoke.gd 2>&1 | tee /tmp/godot-t065-transfers.log\n          grep -q \'T065_TRANSFERS_PASSED\' /tmp/godot-t065-transfers.log\n          if grep -E \'SCRIPT ERROR:|^ERROR:|T065_TRANSFER_FAILED:\' /tmp/godot-t065-transfers.log; then exit 1; fi\n      - name: Verify T-065 Atlas source deletion and NULL repair transaction safety\n        id: ci_t065_atlas_null_transactions\n        if: ${{ !cancelled() }}\n        continue-on-error: true\n        shell: bash\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/object_asset_repair_smoke.gd 2>&1 | tee /tmp/godot-t065-null-transactions.log\n          grep -q \'T065_ASSET_REPAIR_PASSED\' /tmp/godot-t065-null-transactions.log\n          if grep -E \'SCRIPT ERROR:|^ERROR:|T065_ASSET_REPAIR_FAILED:\' /tmp/godot-t065-null-transactions.log; then exit 1; fi\n      - name: Verify T-065 Atlas source manager and deliberate NULL actions\n        id: ci_t065_atlas_source_manager\n        if: ${{ !cancelled() }}\n        continue-on-error: true\n        shell: bash\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/object_source_manager_smoke.gd 2>&1 | tee /tmp/godot-t065-source-manager.log\n          grep -q \'T065_MANAGER_PASSED\' /tmp/godot-t065-source-manager.log\n          if grep -E \'SCRIPT ERROR:|^ERROR:|T065_MANAGER_FAILED:\' /tmp/godot-t065-source-manager.log; then exit 1; fi\n      - name: Verify T-065 Atlas-owned portable Object registration and export\n        id: ci_t065_atlas_portable_registry\n        if: ${{ !cancelled() }}\n        continue-on-error: true\n        shell: bash\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/object_portable_registry_smoke.gd 2>&1 | tee /tmp/godot-t065-portable-registry.log\n          grep -q \'T065_PORTABLE_PASSED\' /tmp/godot-t065-portable-registry.log\n          if grep -E \'SCRIPT ERROR:|^ERROR:|T065_PORTABLE_FAILED:\' /tmp/godot-t065-portable-registry.log; then exit 1; fi\n      - name: Verify T-065 shared Atlas Asset Browser and guarded linked drops\n        id: ci_t065_atlas_browser_bridge\n        if: ${{ !cancelled() }}\n        continue-on-error: true\n        shell: bash\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/asset_browser_atlas_smoke.gd 2>&1 | tee /tmp/godot-t065-atlas-browser.log\n          python3 tools/check_godot_model_log.py /tmp/godot-t065-atlas-browser.log --marker T065_ATLAS_BROWSER_PASSED\n      - name: Verify T-065 large Atlas source catalog paging and global search\n        id: ci_t065_atlas_browser_paging\n        if: ${{ !cancelled() }}\n        continue-on-error: true\n        shell: bash\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/asset_browser_atlas_paging_smoke.gd 2>&1 | tee /tmp/godot-t065-atlas-paging.log\n          grep -q \'T065_PAGING_PASSED\' /tmp/godot-t065-atlas-paging.log\n          if grep -E \'SCRIPT ERROR:|^ERROR:|T065_PAGING_FAILED:\' /tmp/godot-t065-atlas-paging.log; then exit 1; fi\n      - name: Summarize CI failures\n        if: ${{ !cancelled() }}\n        env:\n          GODOT_CI_STEPS_JSON: ${{ toJSON(steps) }}\n        run: python3 tools/report_godot_ci.py\n      - name: Export sanitized hosted CI evidence\n        if: ${{ always() }}\n        env:\n          GODOT_CI_STEPS_JSON: ${{ toJSON(steps) }}\n        run: python3 tools/export_godot_ci_evidence.py --output ci-evidence/godot-fast-ci.json\n      - name: Upload hosted CI evidence (including red runs)\n        if: ${{ always() }}\n        uses: actions/upload-artifact@v4\n        with:\n          name: godot-fast-ci-evidence-${{ github.run_id }}-${{ github.run_attempt }}\n          path: ci-evidence/godot-fast-ci.json\n          if-no-files-found: error\n          retention-days: 30\nname: Godot T-095 60px Brush profile and independent oracle (on demand, software only)\n\non:\n  workflow_dispatch:\n\njobs:\n  brush-profile-native:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          lfs: true\n      - name: Install pinned Godot 4.8 beta 3\n        uses: chickensoft-games/setup-godot@v2\n        with:\n          version: 4.8.0-beta3\n          use-dotnet: false\n      - name: Install software-display dependencies\n        run: sudo apt-get update && sudo apt-get install -y xvfb libgl1-mesa-dri\n      # Required Hokusai native engine must load before any Canvas test.\n      - name: Select Rust for required Hokusai GDExtension\n        uses: dtolnay/rust-toolchain@stable\n      - name: Build and preimport required native brush\n        run: |\n          set -euo pipefail\n          cargo build --manifest-path native/drawing_brush/Cargo.toml --locked --release\n          mkdir -p addons/drawing/native/bin\n          cp native/drawing_brush/target/release/libdrawing_brush.so \\\n            addons/drawing/native/bin/libdrawing_brush.so\n          cp native/drawing_brush/drawing_brush.gdextension.template \\\n            addons/drawing/native/drawing_brush.gdextension\n          python3 tools/build_drawing_app.py --in-place\n          # Pin the extension in Godot\'s initial registry before editor import;\n          # registering after cold editor startup is unsafe on the beta runtime.\n          mkdir -p drawing/.godot\n          printf \'res://addons/drawing/native/drawing_brush.gdextension\\n\' \\\n            > drawing/.godot/extension_list.cfg\n          timeout --signal=TERM --kill-after=5s 240s \\\n            godot --headless --editor --path drawing --import --quit\n      - name: T-095 released-stroke pan/zoom regression with cancelled pending press\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s xvfb-run -a -s \'-screen 0 1280x900x24\' \\\n            godot --display-driver x11 --rendering-method gl_compatibility --audio-driver Dummy \\\n            --path drawing --script res://tests/stroke_navigation_native.gd \\\n            2>&1 | tee /tmp/t095-stroke-navigation.log\n          python3 tools/check_godot_model_log.py /tmp/t095-stroke-navigation.log --marker T095_NAV_PASSED\n      - name: Queued Brush and Eraser graphical history regression\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s xvfb-run -a -s \'-screen 0 1280x900x24\' \\\n            godot --display-driver x11 --rendering-method gl_compatibility --audio-driver Dummy \\\n            --path drawing --script res://tests/t124_queued_brush_native.gd \\\n            2>&1 | tee /tmp/t124-queued-native.log\n          python3 tools/check_godot_model_log.py /tmp/t124-queued-native.log --marker T124_NATIVE_PASSED\n      - name: Exact 60px Brush/Eraser source oracle and transaction rollback\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --audio-driver Dummy --path drawing \\\n            --script res://tests/brush_coverage_smoke.gd 2>&1 | tee /tmp/t095-oracle.log\n          python3 tools/check_godot_model_log.py /tmp/t095-oracle.log --marker T095_ORACLE_PASSED\n      - name: T-095 duplicate stationary hard-brush waypoint/source-history oracle\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --audio-driver Dummy --path drawing \\\n            --script res://tests/t095_duplicate_waypoints_smoke.gd \\\n            2>&1 | tee /tmp/t095-duplicate-waypoints.log\n          python3 tools/check_godot_model_log.py /tmp/t095-duplicate-waypoints.log \\\n            --marker T095_DUPLICATE_WAYPOINT_PASSED\n      - name: T-095 cross-batch stationary Legacy dab source/history and retry oracle\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --audio-driver Dummy --path drawing \\\n            --script res://tests/t095_cross_batch_dab_smoke.gd \\\n            2>&1 | tee /tmp/t095-cross-batch-dab.log\n          python3 tools/check_godot_model_log.py /tmp/t095-cross-batch-dab.log \\\n            --marker T095_CROSS_BATCH_DAB_PASSED\n      - name: T-095 suppress unchanged-preview redraws across delivered input frames\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --audio-driver Dummy --path drawing \\\n            --script res://tests/t095_noop_redraw_smoke.gd \\\n            2>&1 | tee /tmp/t095-noop-redraw.log\n          python3 tools/check_godot_model_log.py /tmp/t095-noop-redraw.log \\\n            --marker T095_NOOP_REDRAW_PASSED\n      - name: T-095 reuse unchanged Canvas preview projection across cursor frames\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --audio-driver Dummy --path drawing \\\n            --script res://tests/t095_preview_index_reuse_smoke.gd \\\n            2>&1 | tee /tmp/t095-preview-index-reuse.log\n          python3 tools/check_godot_model_log.py /tmp/t095-preview-index-reuse.log \\\n            --marker T095_PREVIEW_REUSE_PASSED\n      - name: T-098 exact changed display-tile preview and fallback regression\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s xvfb-run -a -s \'-screen 0 1280x900x24\' \\\n            godot --display-driver x11 --rendering-method gl_compatibility --audio-driver Dummy \\\n            --path drawing --script res://tests/t098_preview_display_cache_smoke.gd \\\n            2>&1 | tee /tmp/t098-preview-display.log\n          python3 tools/check_godot_model_log.py /tmp/t098-preview-display.log \\\n            --marker T098_PREVIEW_DISPLAY_PASSED\n      - name: T-100 sparse atomic tile publication and canonical Undo/Redo oracle\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 180s godot --headless --audio-driver Dummy \\\n            --path drawing --script res://tests/t100_sparse_publication_smoke.gd \\\n            2>&1 | tee /tmp/t100-sparse-publication.log\n          python3 tools/check_godot_model_log.py /tmp/t100-sparse-publication.log \\\n            --marker T100_SPARSE_PUBLICATION_PASSED\n      - name: T-095 internal Brush success-result ownership and history\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --audio-driver Dummy --path drawing \\\n            --script res://tests/t095_brush_result_reuse_smoke.gd 2>&1 | tee /tmp/t095-brush-result.log\n          python3 tools/check_godot_model_log.py /tmp/t095-brush-result.log --marker T095_BRUSH_RESULT_PASSED\n      - name: T-095 original oblique Geometry2D Brush/Eraser parity\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --audio-driver Dummy --path drawing \\\n            --script res://tests/t095_oblique_geometry_smoke.gd 2>&1 | tee /tmp/t095-oblique.log\n          python3 tools/check_godot_model_log.py /tmp/t095-oblique.log --marker T095_OBLIQUE_GEOMETRY_PASSED\n      - name: T-095 stationary and axis-aligned Brush scanline bounds vs Geometry2D\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --audio-driver Dummy --path drawing \\\n            --script res://tests/t095_axis_scanline_bounds_smoke.gd \\\n            2>&1 | tee /tmp/t095-axis-scanline.log\n          python3 tools/check_godot_model_log.py /tmp/t095-axis-scanline.log \\\n            --marker T095_AXIS_SCANLINE_PASSED\n      - name: T-095 conservative oblique Brush scanlines vs full Geometry2D\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --audio-driver Dummy --path drawing \\\n            --script res://tests/t095_oblique_scanline_bounds_smoke.gd \\\n            2>&1 | tee /tmp/t095-oblique-scanlines.log\n          python3 tools/check_godot_model_log.py /tmp/t095-oblique-scanlines.log \\\n            --marker T095_OBLIQUE_SCANLINE_PASSED\n      - name: T-095 sustained input queue compaction and full-path parity\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 180s godot --headless --audio-driver Dummy --path drawing \\\n            --script res://tests/t095_input_queue_compaction_smoke.gd 2>&1 | tee /tmp/t095-queue-compaction.log\n          python3 tools/check_godot_model_log.py /tmp/t095-queue-compaction.log --marker T095_QUEUE_COMPACTION_PASSED\n      - name: T-095 bounded sample-age metrics and long Brush parity\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 180s godot --headless --audio-driver Dummy --path drawing \\\n            --script res://tests/t095_latency_window_smoke.gd 2>&1 | tee /tmp/t095-latency-window.log\n          python3 tools/check_godot_model_log.py /tmp/t095-latency-window.log --marker T095_LATENCY_WINDOW_PASSED\n      - name: T-095 bounded latest stage-batch timing and Brush history parity\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 180s godot --headless --audio-driver Dummy --path drawing \\\n            --script res://tests/t095_stage_batch_window_smoke.gd 2>&1 | tee /tmp/t095-stage-batch-window.log\n          python3 tools/check_godot_model_log.py /tmp/t095-stage-batch-window.log --marker T095_STAGE_BATCH_WINDOW_PASSED\n      - name: T-095 bounded render-frame phase timing, pixels and history\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --audio-driver Dummy --path drawing \\\n            --script res://tests/t095_frame_phase_window_smoke.gd 2>&1 | tee /tmp/t095-frame-phase.log\n          python3 tools/check_godot_model_log.py /tmp/t095-frame-phase.log \\\n            --marker T095_FRAME_PHASE_PASSED\n      - name: T-095 frame-aligned pending input age, queue depth and Brush parity\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --audio-driver Dummy --path drawing \\\n            --script res://tests/t095_frame_input_backlog_smoke.gd 2>&1 | tee /tmp/t095-frame-backlog.log\n          python3 tools/check_godot_model_log.py /tmp/t095-frame-backlog.log \\\n            --marker T095_FRAME_BACKLOG_PASSED\n      - name: T-095 correlate latest Canvas draw with Godot post-draw callback\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --audio-driver Dummy --path drawing \\\n            --script res://tests/t095_frame_post_draw_pairing_smoke.gd \\\n            2>&1 | tee /tmp/t095-postdraw-pairing.log\n          python