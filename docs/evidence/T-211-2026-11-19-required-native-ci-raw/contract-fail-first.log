1 | tee /tmp/godot-t093-discovery-model.log\n          python3 tools/check_godot_model_log.py /tmp/godot-t093-discovery-model.log --marker T093_MODEL_PASSED || ci_fail_marker \'T093 Object discovery model log rejected\'\n          python3 -m unittest discover -s tests -p \'test_t093_object_discovery.py\' -v\n          # T-120 refines File/Open/Object UX without adding to the 46-check inventory.\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path drawing --script res://tests/t120_unified_open_smoke.gd 2>&1 | tee /tmp/godot-t120-open-model.log\n          python3 tools/check_godot_model_log.py /tmp/godot-t120-open-model.log --marker T120_MODEL_PASSED || ci_fail_marker \'T120 unified Open model log rejected\'\n          python3 -m unittest discover -s tests -p \'test_t120_unified_open.py\' -v\n          # T-121 rejects path/decoder TOCTOU by asserting one bounded source snapshot.\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path drawing --script res://tests/t121_raster_snapshot_smoke.gd 2>&1 | tee /tmp/godot-t121-snapshot-model.log\n          python3 tools/check_godot_model_log.py /tmp/godot-t121-snapshot-model.log --marker T121_MODEL_PASSED || ci_fail_marker \'T121 single-snapshot raster Open rejected\'\n          python3 -m unittest discover -s tests -p \'test_t121_raster_snapshot.py\' -v\n          # T-123 rejects decompression bombs from the same captured header bytes.\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path drawing --script res://tests/t123_raster_predecode_bounds_smoke.gd 2>&1 | tee /tmp/godot-t123-bounds-model.log\n          python3 tools/check_godot_model_log.py /tmp/godot-t123-bounds-model.log --marker T123_MODEL_PASSED || ci_fail_marker \'T123 predecode dimensions model log rejected\'\n          python3 -m unittest discover -s tests -p \'test_t123_raster_predecode_bounds.py\' -v\n          ci_finish\n      - name: Verify T-053 standalone Linux release package\n        id: ci_07_verify_t_053_standalone_linux_release_package\n        if: ${{ !cancelled() }}\n        continue-on-error: true\n        shell: bash\n        run: |\n          set -euo pipefail\n          # A fresh isolated stage is required even on repeated CI replays.\n          release_root="$(mktemp -d "${TMPDIR:-/tmp}/drawing-dist.XXXXXXXX")"\n          trap \'rm -rf "$release_root"\' EXIT\n          python3 tools/build_drawing_app.py --output "$release_root/project"\n          godot --headless --editor --path "$release_root/project" --import --quit\n          godot --headless --path "$release_root/project" --export-release Linux "$release_root/Drawing.x86_64"\n          test -s "$release_root/Drawing.x86_64"\n          test -s "$release_root/Drawing.pck"\n          # The .gdextension manifest is packed, but its ELF must be beside the PCK.\n          # Fail closed on missing, unexpected or mismatched native export bytes.\n          python3 tools/package_linux_export.py \\\n            --stage "$release_root/project" --linux "$release_root"\n          python3 -m unittest discover -s tests -p \'test_t201_linux_native_package.py\' -v\n          # Font bytes ship as imported .fontdata, not raw .ttf.\n          # Probe the exported PCK rather than editor source files.\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path "$release_root" --main-pack "$release_root/Drawing.pck" \\\n            --script "$release_root/project/tests/packaged_fonts_smoke.gd" \\\n            2>&1 | tee /tmp/godot-export-fonts.log\n          python3 tools/check_godot_model_log.py /tmp/godot-export-fonts.log --marker DRAWING_PACK_FONT_PASSED\n          # Inspect the exported ELF/PCK and launch with a disposable HOME/CWD.\n          python3 tools/benchmarks/t068_release_gate.py \\\n            --stage "$release_root/project" --linux "$release_root" \\\n            --launch-linux --output /tmp/t068-standalone-linux-release.json\n      # The standalone package import above only registers *its* classes.\n      # The main checkout needs its own class cache before any --path . --script smoke.\n      - name: Import resources and parse scripts\n        id: ci_08_import_resources_and_parse_scripts\n        if: ${{ !cancelled() }}\n        continue-on-error: true\n        shell: bash\n        run: |\n          set -euo pipefail\n          godot --headless --path . --editor --import --quit 2>&1 | tee /tmp/godot-import.log\n          if grep -E \'SCRIPT ERROR:|^ERROR:|Parse Error:|Compile Error:\' /tmp/godot-import.log; then exit 1; fi\n      - name: Verify T-015 retired battlemat authoring and marker-only links\n        id: ci_t015_retired_battlemat_authoring\n        if: ${{ !cancelled() }}\n        continue-on-error: true\n        shell: bash\n        run: |\n          source tools/ci_fail_late.sh\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/t015_retirement_smoke.gd 2>&1 | tee /tmp/godot-t015-retirement.log\n          grep -q \'ATLAS_T015_RETIREMENT_PASSED\' /tmp/godot-t015-retirement.log\n          if grep -E \'SCRIPT ERROR:|^ERROR:|FAILED:\' /tmp/godot-t015-retirement.log; then ci_fail_marker \'Forbidden error marker\'; fi\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/links_smoke.gd 2>&1 | tee /tmp/godot-t015-links.log\n          grep -q \'ATLAS_LINKS_PASSED\' /tmp/godot-t015-links.log\n          if grep -E \'SCRIPT ERROR:|^ERROR:|FAILED:\' /tmp/godot-t015-links.log; then ci_fail_marker \'Forbidden error marker\'; fi\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/linked_maps_ui_smoke.gd 2>&1 | tee /tmp/godot-t015-link-ui.log\n          grep -q \'ATLAS_LINKED_MAPS_UI_PASSED\' /tmp/godot-t015-link-ui.log\n          if grep -E \'SCRIPT ERROR:|^ERROR:|FAILED:\' /tmp/godot-t015-link-ui.log; then ci_fail_marker \'Forbidden error marker\'; fi\n          # Active archival-boundary and modern navigation witnesses: former\n          # spatial placement previews are deliberately not an authoring surface.\n          for witness in \\\n              \'t015_archived_geometry_smoke.gd:ATLAS_T015_ARCHIVE_PASSED\' \\\n              \'overview_smoke.gd:ATLAS_OVERVIEW_PASSED\' \\\n              \'layer_hierarchy_smoke.gd:ATLAS_LAYER_HIERARCHY_PASSED\' \\\n              \'search_stale_actions_smoke.gd:ATLAS_SEARCH_STALE_PASSED\' \\\n              \'organization_ui_smoke.gd:ATLAS_ORGANIZATION_UI_PASSED\' \\\n              \'references_ui_smoke.gd:ATLAS_REFERENCES_UI_PASSED\'; do\n            file="${witness%%:*}"\n            marker="${witness#*:}"\n            log="/tmp/godot-t015-${file%.gd}.log"\n            timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script "res://tests/$file" 2>&1 | tee "$log"\n            grep -q "$marker" "$log"\n            if grep -E \'SCRIPT ERROR:|^ERROR:|FAILED:\' "$log"; then ci_fail_marker \'Forbidden error marker\'; fi\n          done\n          ci_finish\n      - name: Verify T-054 Drawing/Atlas chronological history\n        id: ci_09_verify_t_054_drawing_atlas_chronological_history\n        if: ${{ !cancelled() }}\n        continue-on-error: true\n        shell: bash\n        run: |\n          source tools/ci_fail_late.sh\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/drawing_history_smoke.gd 2>&1 | tee /tmp/godot-drawing-history.log\n          grep -q \'DRAWING_HISTORY_PASSED\' /tmp/godot-drawing-history.log\n          if grep -E \'SCRIPT ERROR:|^ERROR:|FAILED:|failed;\' /tmp/godot-drawing-history.log; then ci_fail_marker \'Forbidden error marker\'; fi\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/drawing_history_editor_smoke.gd 2>&1 | tee /tmp/godot-drawing-history-editor.log\n          grep -q \'DRAWING_HISTORY_EDITOR_PASSED\' /tmp/godot-drawing-history-editor.log\n          if grep -E \'SCRIPT ERROR:|^ERROR:|FAILED:\' /tmp/godot-drawing-history-editor.log; then ci_fail_marker \'Forbidden error marker\'; fi\n          ci_finish\n      - name: Verify T-058 editable text, font integrity and undoable rasterization\n        id: ci_10_verify_t_058_editable_text_font_integrity_and_undoable_rasteriz\n        if: ${{ !cancelled() }}\n        continue-on-error: true\n        shell: bash\n        run: |\n          source tools/ci_fail_late.sh\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/drawing_text_smoke.gd 2>&1 | tee /tmp/godot-drawing-text.log\n          python3 tools/check_godot_model_log.py /tmp/godot-drawing-text.log --marker DRAWING_TEXT_PASSED || ci_fail_marker \'DRAWING_TEXT_PASSED log rejected\'\n          python3 tools/build_drawing_app.py --in-place\n          # Staging refreshes font files: let Godot generate their imported FontFile resources.\n          godot --headless --editor --path drawing --import --quit\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path drawing --script res://tests/text_editor_smoke.gd 2>&1 | tee /tmp/godot-drawing-text-ui.log\n          python3 tools/check_godot_model_log.py /tmp/godot-drawing-text-ui.log --marker DRAWING_TEXT_UI_PASSED || ci_fail_marker \'DRAWING_TEXT_UI_PASSED log rejected\'\n          ci_finish\n      - name: Verify T-060 reusable Object Assets and atomic Save As\n        id: ci_11_verify_t_060_reusable_object_assets_and_atomic_save_as\n        if: ${{ !cancelled() }}\n        continue-on-error: true\n        shell: bash\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/object_assets_smoke.gd 2>&1 | tee /tmp/godot-object-assets.log\n          grep -q \'OBJECT_ASSETS_PASSED\' /tmp/godot-object-assets.log\n          if grep -E \'SCRIPT ERROR:|^ERROR:|FAILED:|OBJECT_ASSETS_FAILED:\' /tmp/godot-object-assets.log; then exit 1; fi\n      - name: Verify T-064 nested Object child graph, safe saves and cycle rejection\n        id: ci_11b_verify_t_064_nested_object_graph\n        if: ${{ !cancelled() }}\n        continue-on-error: true\n        shell: bash\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/object_child_graph_smoke.gd 2>&1 | tee /tmp/godot-t064-child-graph.log\n          grep -q \'T064_CHILD_GRAPH_PASSED\' /tmp/godot-t064-child-graph.log\n          if grep -E \'SCRIPT ERROR:|^ERROR:|T064_CHILD_GRAPH_FAILED:\' /tmp/godot-t064-child-graph.log; then exit 1; fi\n          # T-108 is opt-in while the owner chooses nested Save As semantics.\n          # This tests both transactional candidates without enabling UI behavior.\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/t108_nested_save_as_policy_smoke.gd 2>&1 | tee /tmp/godot-t108-policy.log\n          python3 tools/check_godot_model_log.py /tmp/godot-t108-policy.log --marker T108_POLICY_PASSED\n      - name: Verify T-064 atomic nested Objects project copying\n        id: ci_t064_nested_project_copy\n        if: ${{ !cancelled() }}\n        continue-on-error: true\n        shell: bash\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/object_nested_project_copy_smoke.gd 2>&1 | tee /tmp/godot-t064-project-copy.log\n          python3 tools/check_godot_model_log.py /tmp/godot-t064-project-copy.log --marker T064_PROJECT_COPY_PASSED\n          # A saved portable campaign copy includes all retained Drawing/Objects/\n          # Fonts generations, verified before one destination directory rename.\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/object_nested_campaign_copy_smoke.gd 2>&1 | tee /tmp/godot-t064-campaign-copy.log\n          python3 tools/check_godot_model_log.py /tmp/godot-t064-campaign-copy.log --marker T064_CAMPAIGN_COPY_PASSED\n          # Atlas File > Copy saved campaign routes through the same verified API.\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/object_nested_campaign_copy_ui_smoke.gd 2>&1 | tee /tmp/godot-t064-copy-ui.log\n          python3 tools/check_godot_model_log.py /tmp/godot-t064-copy-ui.log --marker T064_COPY_UI_PASSED\n      - name: Verify T-064 bounded nested source composition and hit paths\n        id: ci_t064_nested_source_render\n        if: ${{ !cancelled() }}\n        continue-on-error: true\n        shell: bash\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/object_child_render_smoke.gd 2>&1 | tee /tmp/godot-t064-child-render.log\n          grep -q \'T064_CHILD_RENDER_PASSED\' /tmp/godot-t064-child-render.log\n          if grep -E \'SCRIPT ERROR:|^ERROR:|T064_RENDER_FAILED:\' /tmp/godot-t064-child-render.log; then exit 1; fi\n      - name: Verify T-064 parent-scoped nested child transforms and history\n        id: ci_t064_nested_child_edit\n        if: ${{ !cancelled() }}\n        continue-on-error: true\n        shell: bash\n        run: |\n          set -euo pipefail\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/object_child_edit_smoke.gd 2>&1 | tee /tmp/godot-t064-child-edit.log\n          grep -q \'T064_CHILD_EDIT_PASSED\' /tmp/godot-t064-child-edit.log\n          if grep -E \'SCRIPT ERROR:|^ERROR:|T064_CHILD_EDIT_FAILED:\' /tmp/godot-t064-child-edit.log; then exit 1; fi\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/object_child_structure_smoke.gd 2>&1 | tee /tmp/godot-t064-child-structure.log\n          grep -q \'T064_CHILD_STRUCTURE_PASSED\' /tmp/godot-t064-child-structure.log\n          if grep -E \'SCRIPT ERROR:|^ERROR:|T064_CHILD_STRUCTURE_FAILED:\' /tmp/godot-t064-child-structure.log; then exit 1; fi\n          # Repair retained NULL children through the same optimistic graph\n          # boundary and reversible parent-scoped history (no owner UX gate).\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/object_child_null_repair_smoke.gd 2>&1 | tee /tmp/godot-t064-child-null-repair.log\n          grep -q \'T064_CHILD_REPAIR_PASSED\' /tmp/godot-t064-child-null-repair.log\n          if grep -E \'SCRIPT ERROR:|^ERROR:|T064_CHILD_REPAIR_FAILED:\' /tmp/godot-t064-child-null-repair.log; then exit 1; fi\n          # Uniform child scaling shares the optimistic transform timeline.\n          # A native inspector screenshot is targeted, never fast push CI.\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/object_child_scale_smoke.gd 2>&1 | tee /tmp/godot-t064-child-scale.log\n          grep -q \'T064_CHILD_SCALE_PASSED\' /tmp/godot-t064-child-scale.log\n          if grep -E \'SCRIPT ERROR:|^ERROR:|T064_CHILD_SCALE_FAILED:\' /tmp/godot-t064-child-scale.log; then exit 1; fi\n          # T-064 sibling paint order uses the same atomic graph/history path;\n          # no native framebuffer suite is added to the fast push job.\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/object_child_order_smoke.gd 2>&1 | tee /tmp/godot-t064-child-order.log\n          grep -q \'T064_CHILD_ORDER_PASSED\' /tmp/godot-t064-child-order.log\n          if grep -E \'SCRIPT ERROR:|^ERROR:|T064_CHILD_ORDER_FAILED:\' /tmp/godot-t064-child-order.log; then exit 1; fi\n          # Optional labels distinguish repeated child instances without renaming\n          # their shared source; no native framebuffer suite runs on fast CI.\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/object_child_label_smoke.gd 2>&1 | t