7_verify_t_053_standalone_linux_release_package\n        if: ${{ !cancelled() }}\n        continue-on-error: true\n        shell: bash\n        run: |\n          set -euo pipefail\n          # A fresh isolated stage is required even on repeated CI replays.\n          release_root="$(mktemp -d "${TMPDIR:-/tmp}/drawing-dist.XXXXXXXX")"\n          trap \'rm -rf "$release_root"\' EXIT\n          python3 tools/build_drawing_app.py --output "$release_root/project"\n          godot --headless --editor --path "$release_root/project" --import --quit\n          godot --headless --path "$release_root/project" --export-release Linux "$release_root/Drawing.x86_64"\n          test -s "$release_root/Drawing.x86_64"\n          test -s "$release_root/Drawing.pck"\n          # The .gdextension manifest is packed, but its ELF must be beside the PCK.\n          # Fail closed on missing, unexpected or mismatched native export bytes.\n          python3 tools/package_linux_export.py \\\n            --stage "$release_root/project" --linux "$release_root"\n          python3 -m unittest discover -s tests -p \'test_t201_linux_native_package.py\' -v\n          # Font bytes ship as imported .fontdata, not raw .ttf.\n          # Probe the exported PCK rather than editor source files.\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path "$release_root" --main-pack "$release_root/Drawing.pck" \\\n            --script "$release_root/project/tests/packaged_fonts_smoke.gd" \\\n            2>&1 | tee /tmp/godot-export-fonts.log\n          python3 tools/check_godot_model_log.py /tmp/godot-export-fonts.log --marker DRAWING_PACK_FONT_PASSED\n          # Inspect the exported ELF/PCK and launch with a disposable HOME/CWD.\n          python3 tools/benchmarks/t068_release_gate.py \\\n            --stage "$release_root/project" --linux "$release_root" \\\n            --launch-linux --output /tmp/t068-standalone-linux-release.json\n      # The standalone package import above only registers *its* classes.\n      # The main checkout needs its own class cache before any --path . --script smoke.\n      - name: Import resources and parse scripts\n        id: ci_08_import_resources_and_parse_scripts\n        if: ${{ !cancelled() }}\n        continue-on-error: true\n        shell: bash\n        run: |\n          set -euo pipefail\n          godot --headless --path . --editor --import --quit 2>&1 | tee /tmp/godot-import.log\n          if grep -E \'SCRIPT ERROR:|^ERROR:|Parse Error:|Compile Error:\' /tmp/godot-import.log; then exit 1; fi\n      - name: Verify T-015 retired battlemat authoring and marker-only links\n        id: ci_t015_retired_battlemat_authoring\n        if: ${{ !cancelled() }}\n        continue-on-error: true\n        shell: bash\n        run: |\n          source tools/ci_fail_late.sh\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/t015_retirement_smoke.gd 2>&1 | tee /tmp/godot-t015-retirement.log\n          grep -q \'ATLAS_T015_RETIREMENT_PASSED\' /tmp/godot-t015-retirement.log\n          if grep -E \'SCRIPT ERROR:|^ERROR:|FAILED:\' /tmp/godot-t015-retirement.log; then ci_fail_marker \'Forbidden error marker\'; fi\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/links_smoke.gd 2>&1 | tee /tmp/godot-t015-links.log\n          grep -q \'ATLAS_LINKS_PASSED\' /tmp/godot-t015-links.log\n          if grep -E \'SCRIPT ERROR:|^ERROR:|FAILED:\' /tmp/godot-t015-links.log; then ci_fail_marker \'Forbidden error marker\'; fi\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/linked_maps_ui_smoke.gd 2>&1 | tee /tmp/godot-t015-link-ui.log\n          grep -q \'ATLAS_LINKED_MAPS_UI_PASSED\' /tmp/godot-t015-link-ui.log\n          if grep -E \'SCRIPT ERROR:|^ERROR:|FAILED:\' /tmp/godot-t015-link-ui.log; then ci_fail_marker \'Forbidden error marker\'; fi\n          # Active archival-boundary and modern navigation witnesses: former\n          # spatial placement previews are deliberately not an authoring surface.\n          for witness in \\\n              \'t015_archived_geometry_smoke.gd:ATLAS_T015_ARCHIVE_PASSED\' \\\n              \'overview_smoke.gd:ATLAS_OVERVIEW_PASSED\' \\\n              \'layer_hierarchy_smoke.gd:ATLAS_LAYER_HIERARCHY_PASSED\' \\\n              \'search_stale_actions_smoke.gd:ATLAS_SEARCH_STALE_PASSED\' \\\n              \'organization_ui_smoke.gd:ATLAS_ORGANIZATION_UI_PASSED\' \\\n              \'references_ui_smoke.gd:ATLAS_REFERENCES_UI_PASSED\'; do\n            file="${witness%%:*}"\n            marker="${witness#*:}"\n            log="/tmp/godot-t015-${file%.gd}.log"\n            timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script "res://tests/$file" 2>&1 | tee "$log"\n            grep -q "$marker" "$log"\n            if grep -E \'SCRIPT ERROR:|^ERROR:|FAILED:\' "$log"; then ci_fail_marker \'Forbidden error marker\'; fi\n          done\n          ci_finish\n      - name: Verify T-054 Drawing/Atlas chronological history\n        id: ci_09_verify_t_054_drawing_atlas_chronological_history\n        if: ${{ !cancelled() }}\n        continue-on-error: true\n        shell: bash\n        run: |\n          source tools/ci_fail_late.sh\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/drawing_history_smoke.gd 2>&1 | tee /tmp/godot-drawing-history.log\n          grep -q \'DRAWING_HISTORY_PASSED\' /tmp/godot-drawing-history.log\n          if grep -E \'SCRIPT ERROR:|^ERROR:|FAILED:|failed;\' /tmp/godot-drawing-history.log; then ci_fail_marker \'Forbidden error marker\'; fi\n          timeout --signal=TERM --kill-after=5s 120s godot --headless --path . --script res://tests/drawing_history_editor_smoke.gd 2>&1 | tee /tmp/godot-drawing-history-editor.log\n          grep -q \'DRAWING_HISTORY_EDITOR_PASSED\' /tmp/godot-drawing-history-editor.log\n          if grep -E \'SCRIPT ER