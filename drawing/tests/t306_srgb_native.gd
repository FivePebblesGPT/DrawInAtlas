extends "t304_selection_menu_native.gd"
## Real picker → native Brush → detached preview → committed bytes → display.

func check(ok: bool, label: String) -> void:
	checks += 1
	if not ok:
		failures += 1
		printerr("T306_NATIVE_FAILED: " + label)

func capture(name: String) -> void:
	var directory: String = OS.get_environment("T306_SCREENSHOTS")
	if not directory.is_empty():
		DirAccess.make_dir_recursive_absolute(directory)
		root.get_texture().get_image().save_png(directory.path_join(name + ".png"))

func sample(canvas: Control, pixel: Vector2i) -> Color:
	var location: Vector2i = Vector2i(canvas.global_position + canvas.pixel_to_position(Vector2(pixel) + Vector2(0.5, 0.5)))
	return canvas.get_viewport().get_texture().get_image().get_pixelv(location)

func near_rgb(actual: Color, expected: Color, tolerance: int = 1) -> bool:
	return absi(actual.r8 - expected.r8) <= tolerance and absi(actual.g8 - expected.g8) <= tolerance and absi(actual.b8 - expected.b8) <= tolerance

func fill(doc: DrawingDocument, layer: String, rect: Rect2i, rgba: int) -> void:
	var edit: DrawingEditSession = doc.begin_edit(layer, doc.revision).value
	check(edit.fill_rect(rect, rgba).ok and edit.commit().ok, "fixture edit")

func run() -> void:
	if DisplayServer.get_name() == "headless" or not ClassDB.class_exists("DrawingNativeTiles"):
		check(false, "mandatory real display and Rust extension")
		quit(1)
		return
	root.size = Vector2i(1280, 800)
	root.position = Vector2i(40, 40)
	var app: Control = load("res://main.tscn").instantiate()
	app.layout_persistence_enabled = false
	app.preferences_persistence_enabled = false
	root.add_child(app)
	await frames(15)
	check(not root.use_hdr_2d and RenderingServer.get_current_rendering_method() == "gl_compatibility", "SDR compatibility framebuffer")
	var canvas: Control = app.canvas
	var doc: DrawingDocument = app.current_document()
	var layer: String = app.current_layer()
	canvas.camera = Vector2.ZERO
	canvas.zoom = 8.0
	canvas.image_bounds = Rect2i(-36, -28, 72, 56)
	canvas.show_pixel_grid = false
	canvas.show_grid = false
	# Opaque swatches independently selected to span the transfer knee, primaries and midtones.
	var colors: Array[Color] = [Color8(0, 0, 0), Color8(10, 10, 10), Color8(64, 128, 192), Color8(128, 128, 128), Color8(255, 0, 128), Color8(255, 255, 255)]
	for i: int in range(colors.size()):
		fill(doc, layer, Rect2i(-30 + 10 * i, -22, 10, 8), app._pack_color(colors[i]))
	# Separate base and overlaid layer demonstrate encoded-space layer arithmetic.
	fill(doc, layer, Rect2i(-30, -12, 20, 8), 0xff000000)
	var top: String = str(doc.create_layer(DrawingLayerNode.RASTER, "Overlay").value)
	fill(doc, top, Rect2i(-30, -12, 20, 8), 0x80ffffff)
	# Render a neutral ramp to detect a missing or duplicate display conversion.
	for i: int in range(16):
		var v: int = i * 17
		fill(doc, layer, Rect2i(-32 + i * 4, -2, 4, 8), v | (v << 8) | (v << 16) | 0xff000000)
	canvas.queue_redraw()
	await frames(12)
	for i: int in range(colors.size()):
		var actual: Color = sample(canvas, Vector2i(-25 + 10 * i, -18))
		check(near_rgb(actual, colors[i]), "framebuffer opaque swatch %d expected %s actual %s" % [i, colors[i].to_html(), actual.to_html()])
	check(near_rgb(sample(canvas, Vector2i(-20, -8)), Color8(128, 128, 128)), "actual composite framebuffer 128, not linear-light 188")
	var screen: Image = DisplayServer.screen_get_image(0)
	var screen_point: Vector2i = root.position + Vector2i(canvas.global_position + canvas.pixel_to_position(Vector2(-4.5, -17.5)))
	check(screen != null and near_rgb(screen.get_pixelv(screen_point), Color8(64, 128, 192)), "X11 screen capture matches the Godot framebuffer")
	for i: int in range(16):
		var v: int = i * 17
		check(near_rgb(sample(canvas, Vector2i(-30 + i * 4, 1)), Color8(v, v, v)), "actual framebuffer gray ramp %d" % v)
	# Route real ColorPicker signals as generated by RGB/HSV/hex editors.
	app.color_advanced.color = Color8(64, 128, 192, 255)
	app.color_advanced.color_changed.emit(app.color_advanced.color)
	check(app.active_color == Color8(64, 128, 192) and canvas.color_rgba == 0xffc08040 and app.color_hex.text == "#4080C0FF", "picker routes encoded sRGB and alpha without conversion")
	app._set_brush_width(8.0)
	app._set_brush_opacity(1.0)
	canvas.start_gesture(canvas.pixel_to_position(Vector2(-20.5, 15.5)))
	canvas.update_gesture(canvas.pixel_to_position(Vector2(-10.5, 15.5)))
	await frames(6)
	check(canvas.session != null and canvas._active_brush_backend == "Hokusai", "native Brush detached preview")
	var preview: Color = sample(canvas, Vector2i(-16, 15))
	check(near_rgb(preview, Color8(64, 128, 192), 2), "Brush preview matches picker (expected 4080c0, actual %s)" % preview.to_html())
	await capture("srgb-preview")
	canvas.finish_gesture(canvas.pixel_to_position(Vector2(-8.5, 15.5)))
	for i: int in range(120):
		if canvas.session == null:
			break
		await frames(1)
	await frames(8)
	var rgba: int = int(doc.read_pixel(layer, -16, 15).value)
	check(rgba == 0xffc08040, "opaque Brush document bytes match picker (actual %08x)" % rgba)
	check(near_rgb(sample(canvas, Vector2i(-16, 15)), Color8(64, 128, 192), 1), "committed Brush framebuffer matches encoded sRGB")
	# Fractional opacity is a linear coverage multiplier, not gamma encoded.
	var checker: Color = sample(canvas, Vector2i(15, 15))
	app.color_advanced.color = Color8(128, 64, 192, 128)
	app.color_advanced.color_changed.emit(app.color_advanced.color)
	canvas.start_gesture(canvas.pixel_to_position(Vector2(9.5, 15.5)))
	canvas.update_gesture(canvas.pixel_to_position(Vector2(19.5, 15.5)))
	canvas.finish_gesture(canvas.pixel_to_position(Vector2(21.5, 15.5)))
	for i: int in range(120):
		if canvas.session == null:
			break
		await frames(1)
	await frames(8)
	rgba = int(doc.read_pixel(layer, 15, 15).value)
	check(rgba == 0x80c04080, "half-alpha Brush preserves straight RGB and 128 alpha (actual %08x)" % rgba)
	var expected: Color = Color8(roundi((128 * 128 + checker.r8 * 127) / 255.0),
		roundi((64 * 128 + checker.g8 * 127) / 255.0), roundi((192 * 128 + checker.b8 * 127) / 255.0))
	check(near_rgb(sample(canvas, Vector2i(15, 15)), expected, 2), "software framebuffer applies linear coverage to encoded RGB")
	check(doc.undo().ok and int(doc.read_pixel(layer, 15, 15).value) == 0, "Undo removes half-alpha stroke")
	check(doc.redo().ok and int(doc.read_pixel(layer, 15, 15).value) == 0x80c04080, "Redo retains correct encoded RGB and alpha")
	await frames(8)
	await capture("srgb-committed")
	print("T306_NATIVE: %d checks; %d failed" % [checks, failures])
	if failures == 0:
		print("T306_NATIVE_PASSED")
	root.remove_child(app)
	app.free()
	quit(1 if failures else 0)
