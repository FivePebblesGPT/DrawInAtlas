[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/atlas_board_dialog.gd" id="1"]
[ext_resource type="PackedScene" path="res://prefab/grid_controls.tscn" id="2"]

[node name="BoardDialog" type="ConfirmationDialog"]
script = ExtResource("1")
title = "New board"
ok_button_text = "Create"
dialog_hide_on_ok = false

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
custom_minimum_size = Vector2(400, 420)
horizontal_scroll_mode = 0
follow_focus = true

[node name="Margin" type="MarginContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="Form" type="VBoxContainer" parent="Scroll/Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="BoardNameLabel" type="Label" parent="Scroll/Margin/Form"]
layout_mode = 2
text = "Board name"

[node name="NameInput" type="LineEdit" parent="Scroll/Margin/Form"]
layout_mode = 2
placeholder_text = "Untitled board"

[node name="GridControls" parent="Scroll/Margin/Form" instance=ExtResource("2")]
layout_mode = 2

