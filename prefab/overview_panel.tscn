[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/atlas_overview_panel.gd" id="1"]
[ext_resource type="PackedScene" path="res://prefab/preview_panel.tscn" id="2"]

[node name="OverviewPanel" type="VBoxContainer"]
script = ExtResource("1")
theme_override_constants/separation = 8

[node name="ModePicker" type="OptionButton" parent="."]
layout_mode = 2

[node name="RecursiveCheckbox" type="CheckBox" parent="."]
layout_mode = 2
button_pressed = true
text = "Include descendants"

[node name="Summary" type="Label" parent="."]
layout_mode = 2
autowrap_mode = 3
theme_type_variation = &"MutedLabel"

[node name="ResultList" type="ItemList" parent="."]
layout_mode = 2
custom_minimum_size = Vector2(0, 100)
size_flags_vertical = 3

[node name="OpenButton" type="Button" parent="."]
layout_mode = 2
text = "Open map / floor"

[node name="FocusButton" type="Button" parent="."]
layout_mode = 2
text = "Focus source anchor"

[node name="Preview" parent="." instance=ExtResource("2")]
layout_mode = 2
